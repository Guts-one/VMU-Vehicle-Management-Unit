{
  "name": "vmu-mode-logic",
  "version": "2.2.0",
  "private": true,
  "description": "VMU supervisory mode logic — web simulator (mode_logic.js) and the deterministic JS<->C equivalence harness.",
  "scripts": {
    "test:c": "node scripts/run_unit_tests.js",
    "test:ui": "node --test verification/simulator_ui.test.js",
    "build:replays": "node verification/model_replay/prepare_replays.js --build",
    "test:replays": "node verification/model_replay/prepare_replays.js --check",
    "verify": "node verification/js_equivalence/verify.js",
    "equiv": "node verification/js_equivalence/run_js_equivalence.js --probe-out build/js_equivalence/probe_out.csv --out build/js_equivalence/js_out.csv",
    "equiv:mirror": "node verification/js_equivalence/run_js_equivalence.js",
    "mcdc": "node verification/js_equivalence/mcdc_independence_pairs.js",
    "coverage": "c8 --include=mode_logic.js --reporter=text --reporter=json-summary node verification/js_equivalence/run_coverage.js",
    "test": "node verification/js_equivalence/verify.js && npm run coverage && npm run test:replays && npm run test:ui"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
